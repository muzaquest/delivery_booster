modules = ["bash", "python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "ocl-icd", "opencl-headers", "sqlite"]

[workflows]
runButton = "Restaurant Analytics Platform"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Delivery Booster"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Restaurant Analytics Platform"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FastAPI Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Streamlit Frontend"

[[workflows.workflow]]
name = "Restaurant Analytics Platform"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'bash scripts/run.sh'"
waitForPort = 5000

[[workflows.workflow]]
name = "FastAPI Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "Streamlit Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run streamlit_app.py --server.address 0.0.0.0 --server.port 5000 --server.headless true --server.allowRunOnSave false --server.enableCORS false --server.enableXsrfProtection false"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
run = ["bash", "-lc", "bash scripts/run.sh"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[env]
PYTHONPATH = "$PYTHONPATH:."

[agent]
expertMode = true
